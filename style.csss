* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #111;
    color: white;
}


/* HEADER */

header {
    height: 80px;
    padding: 0 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #111;
}

.logo {
    font-size: 23px;
    font-weight: bold;
}

.logo span {
    color: #ff8c00;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
}

nav a:hover {
    color: #ff8c00;
}

.cart {
    padding: 10px 18px;
    border: 1px solid #ff8c00;
    background: transparent;
    color: white;
    border-radius: 20px;
}


/* HERO */

.hero {
    min-height: 620px;
    padding: 70px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #171717;
}

.hero-text {
    width: 48%;
}

.small-title {
    color: #ff8c00;
    font-size: 14px;
    letter-spacing: 3px;
    font-weight: bold;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: 65px;
    line-height: 1.05;
    margin-bottom: 25px;
}

.hero h1 span,
h2 span {
    color: #ff8c00;
}

.description {
    color: #ccc;
    font-size: 18px;
    line-height: 1.7;
    max-width: 500px;
}

.main-btn {
    margin-top: 30px;
    padding: 15px 28px;
    border: none;
    border-radius: 30px;
    background: #ff8c00;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

.main-btn:hover {
    transform: scale(1.05);
}


/* HERO IMAGE */

.hero-image {
    width: 440px;
    height: 440px;
    position: relative;
}

.hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 8px solid #ff8c00;
}


/* MENU */

.menu {
    padding: 90px 8%;
    text-align: center;
    background: #0d0d0d;
}

.menu h2,
.special h2,
.about h2 {
    font-size: 45px;
    margin-bottom: 45px;
}

.cards {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
}

.card {
    width: 300px;
    background: #1c1c1c;
    padding: 15px;
    border-radius: 20px;
    text-align: left;
    position: relative;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-10px);
}

.card img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    border-radius: 15px;
}

.tag {
    position: absolute;
    top: 25px;
    left: 25px;
    background: #ff8c00;
    padding: 7px 12px;
    border-radius: 15px;
    font-size: 11px;
    font-weight: bold;
}

.card h3 {
    margin: 18px 5px 8px;
}

.card p {
    color: #aaa;
    line-height: 1.5;
    margin: 0 5px 15px;
}

.bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 5px;
}

.bottom b {
    color: #ff8c00;
    font-size: 20px;
}

.bottom button {
    width: 35px;
    height: 35px;
    border: none;
    border-radius: 50%;
    background: #ff8c00;
    color: white;
    font-size: 20px;
}


/* SPECIAL */

.special {
    padding: 90px 12%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #181818;
}

.special > div:first-child {
    max-width: 550px;
}

.special p {
    color: #bbb;
    line-height: 1.7;
}

.special-box {
    width: 280px;
    padding: 45px 20px;
    text-align: center;
    border: 2px solid #ff8c00;
    border-radius: 25px;
    background: #222;
    font-size: 50px;
}

.special-box h3 {
    font-size: 20px;
    margin: 15px 0;
}

.special-box p {
    font-size: 15px;
}

.special-box strong {
    color: #ff8c00;
    font-size: 25px;
}


/* ABOUT */

.about {
    padding: 90px 15%;
    text-align: center;
    background: #101010;
}

.about p:last-child {
    color: #bbb;
    max-width: 650px;
    margin: auto;
    line-height: 1.8;
}


/* CONTACT */

.contact {
    padding: 70px 10%;
    text-align: center;
    background: #ff8c00;
}

.contact h2 {
    font-size: 40px;
    margin-bottom: 25px;
}

.contact h2 span {
    color: #111;
}

.contact p {
    margin: 10px;
}


/* FOOTER */

footer {
    text-align: center;
    padding: 20px;
    background: #080808;
    color: #aaa;
}


/* MOBILE */

@media (max-width: 800px) {

    header {
        flex-direction: column;
        height: auto;
        padding: 20px;
        gap: 15px;
    }

    nav a {
        margin: 5px;
    }

    .hero {
        flex-direction: column;
        text-align: center;
        gap: 50px;
    }

    .hero-text {
        width: 100%;
    }

    .hero h1 {
        font-size: 45px;
    }

    .hero-image {
        width: 300px;
        height: 300px;
    }

    .special {
        flex-direction: column;
        gap: 40px;
        text-align: center;
    }
}